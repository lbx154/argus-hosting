{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "preserveSymlinks": true,
    "paths": {
      "@argus-web/*": [
        "node_modules/@argus-source/frontend/web/src/*"
      ],
      "@argus-core/*": [
        "node_modules/@argus-source/frontend/core/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
